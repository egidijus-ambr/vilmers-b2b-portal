# Your Medusa backend, should be updated to where you are hosting your server. Remember to update CORS settings for your server. See – https://docs.medusajs.com/usage/configurations#admin_cors-and-store_cors
FURNISYSTEMS_BACKEND_URL=http://localhost:9000

# Required. The Furnisystems backend GraphQL endpoint (enforced by check-env-variables.js).
NEXT_PUBLIC_BACKEND_GRAPHQL=http://localhost:4000/graphql

# Required. The Furnisystems backend REST API endpoint (enforced by check-env-variables.js).
NEXT_PUBLIC_BACKEND_REST_API=http://localhost:4000

# Your store URL, should be updated to where you are hosting your storefront.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Your preferred default region. When middleware cannot determine the user region from the "x-vercel-country" header, the default region will be used. ISO-2 lowercase format.
NEXT_PUBLIC_DEFAULT_REGION=us

# Your Stripe public key. See – https://docs.medusajs.com/add-plugins/stripe
NEXT_PUBLIC_STRIPE_KEY=

# Publishable API key used by the Furnisystems SDK client (see src/lib/config.ts).
NEXT_PUBLIC_FURNISYSTEMS_PUBLISHABLE_KEY=

# Your Next.js revalidation secret. See – https://nextjs.org/docs/app/building-your-application/data-fetching/fetching-caching-and-revalidating#on-demand-revalidation
REVALIDATE_SECRET=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9

# Locize configuration for translation management
LOCIZE_PROJECT_ID=your_project_id_here
LOCIZE_API_KEY=your_api_key_here

# Brand theme selector (src/themes). Selects the color/font preset baked into this
# build (see src/themes/index.ts). Defaults to "vilmers" when unset; an unknown value
# fails the build fast.
# INVARIANT: one deployment = one brand = one store. Since the theme is frozen at
# build time (build-per-brand), NEXT_PUBLIC_THEME MUST match the store this build's
# other env vars point at — otherwise the deployment renders one brand's palette
# under another brand's logo/content.
NEXT_PUBLIC_THEME=vilmers

# Feature flags (centralized in src/lib/features.ts via src/lib/env.ts). All are
# optional and default as noted below; changing one requires a rebuild (values are
# inlined at `next build`).

# When "true", enables the customer-facing order details page/link.
NEXT_PUBLIC_FEATURE_ORDER_DETAILS=false

# When "true", nav menu items are built dynamically from live product categories
# instead of the static navigation config.
NEXT_PUBLIC_FEATURE_PRODUCT_CATALOG=false

# When "true", PDP configurator button navigates to /[lang]/products/[handle]/configurator
# instead of opening the modal. Used for UX A/B testing.
NEXT_PUBLIC_CONFIGURATOR_PAGE_ENABLED=false

# When "true", shows the order line item volume column/value on the order details
# page and offer PDF.
NEXT_PUBLIC_SHOW_VOLUME=false

# When "true", shows delivery/shipping cost information on the order details page.
NEXT_PUBLIC_SHOW_DELIVERY_SHIPPING_INFORMATION=false

# When "true", shows VAT (PVM) line/amount on the order details page and offer PDF.
NEXT_PUBLIC_SHOW_PVM=false

# MailerLite (server-only). Newsletter signups POST to MailerLite's Classic API
# (https://api.mailerlite.com/api/v2). When MAILERLITE_API_KEY is empty/unset, submission
# simulates success (useful for local dev). Set MAILERLITE_GROUP_ID to a MailerLite group id
# to add subscribers to that group; leave empty to add to the general subscriber list.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Tawk.to configuration for chat widget and login functionality
# Set to "false" to disable Tawk.to chat widget entirely (default ON — see
# src/lib/features.ts).
NEXT_PUBLIC_TAWK_ENABLED=true
NEXT_PUBLIC_TAWK_PROPERTY_ID=692400fe12586c1960a8d887
NEXT_PUBLIC_TAWK_WIDGET_ID=1jaqa7p8d
TAWK_API_KEY=your_tawk_api_key_here

# Vilmers Dynamics AX availability proxy (server-only)
VILMERS_AX_API_BASE_URL=https://furnisys.vilmers.com
VILMERS_AX_API_KEY=

# Dev-only direct toggles (not part of src/lib/features.ts — internal/debug tools,
# not user-facing product features):
# NEXT_PUBLIC_SHOW_SOFA_SHAPE_GIZMO=true   # configurator canvas debug gizmo overlay
# NEXT_PUBLIC_SHOW_PWA_PROMPT=true         # force-show the "install app" PWA prompt
